# =============================================================================
# CargoSync Frontend — Environment Configuration Template
# =============================================================================
# Copy this file to '.env.local' and update the values for your environment.
# DO NOT commit your actual '.env.local' file containing real secrets to version control.

# Backend API Endpoint (FastAPI root v1 endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
