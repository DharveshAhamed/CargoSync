# CargoSync .gitignore

# Environment files & Secrets
.env
.env.*
.env.local
.env.*.local
.env.production
!.env.example
*.pem
*.key

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js Build Output
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Python Virtual Environments
venv/
.venv/
env/
backend/venv/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases, local storage & dumps
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# Runtime & Generated Files
backend/generated/
outputs/
uploads/
*.pdf

# Logs
*.log

# Coverage & Testing
coverage/
htmlcov/
.coverage
.coverage.*

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Backups & Archives
*.bak
*_old
*.zip
*.tar.gz
*.rar
