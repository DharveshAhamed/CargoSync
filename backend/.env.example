# =============================================================================
# CargoSync Backend — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and update the values for your environment.
# DO NOT commit your actual '.env' file containing real secrets to version control.

# Application Settings
APP_NAME="CargoSync API"
APP_VERSION="1.0.0"
DEBUG=false

# Supabase Credentials (optional if running purely on local SQLite)
# Find these in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Database Connection URL
# For Supabase PostgreSQL (Transaction Pooler port 6543 or Session port 5432):
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# For Local SQLite fallback (leave DATABASE_URL empty or comment out):
# DATABASE_URL=sqlite:///./cargosync.db

# JWT Security
# Generate a secure 64-character secret key with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / Allowed Origins
FRONTEND_URL=http://localhost:3000
